# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.ipynb_checkpoints/

# FEM / mesh outputs (regenerated by mesh/build_mesh.py)
*.msh
*.xdmf
*.h5

# Solver / sweep results (regenerated by solve/, sweep/, optimize/)
*.npz
*.csv

# pycma's own internal diagnostic logs (regenerated by optimize/cmaes_search.py)
outcmaes/

# Generated figures (visualization/*.png)
*.png

# Presentation slide decks (binary, not diffable)
*.pptx

# FFCx JIT compilation cache artifacts (accidentally committed once as
# part of a diagnostic dump directory, see fd6c6e3 / CLAUDE.md) -- "fenics"
# is FFCx's own JIT cache directory name, matching ~/.cache/fenics
**/fenics/
*.so
*.o
*.c.cached
mumps_verbose*.log

# Misc OS / editor cruft
.DS_Store
*.swp

# ZONE Identifier files
.Identifier
